{
  "$schema": "https://react.doctor/schema/config.json",

  // Require-pnpm-hardening: NO aplicable. Activar minimumReleaseAge (10080) +
  // trustPolicy (no-downgrade) hace fallar la verificación de resolución del
  // lockfile (ERR_PNPM_LOCKFILE_RESOLUTION_VERIFICATION) en 8 dependencias
  // transitorias, la mayoría falsos positivos de "posible package takeover"
  // por debilitamiento de firma/provenance (ej.: undici-types, reselect,
  // next-auth@beta, semver). pnpm-workspace.yaml se mantiene sin endurecer
  // porque el sistema de seguridad de pnpm no es adoptable en este stack.
  "ignore": {
    "rules": ["react-doctor/require-pnpm-hardening"],
    "overrides": [
      // Cómputos financieros de kardex: el orden secuencial preserva la
      // semántica de lotes PEPS, saldos y validaciones. Paralelizar esos
      // awaits introduciría riesgo silencioso de ordenamiento.
      {
        "files": [
          "src/lib/services/pos.service.ts",
          "src/lib/services/producto-terminado.service.ts",
          "src/lib/services/reportes.service.ts",
          "src/actions/reporte-general-base-activa.actions.ts"
        ],
        "rules": ["react-doctor/server-sequential-independent-await"]
      },
      {
        "files": [
          "src/lib/services/peps.service.ts",
          "src/lib/services/saldo-base.service.ts"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      // pos-page.tsx: update de estado tras await dentro de un efecto que
      // sincroniza el tipo de cambio con SUNAT; protegido con flag `activo`
      // (cleanup) — patrón correcto de "sync with external system".
      {
        "files": ["src/components/pos/pos-page.tsx"],
        "rules": ["react-doctor/no-set-state-after-await-in-effect"]
      },
      // Diálogos de catálogo/producto: el efecto solo dispara callbacks de
      // éxito al padre (toast + refresh + cerrar); no se eleva ningún dato
      // producido por el hijo. Excepción documentada de la regla.
      {
        "files": [
          "src/components/catalogos/catalogo-dialog.tsx",
          "src/components/productos/producto-dialog.tsx"
        ],
        "rules": ["react-doctor/no-pass-data-to-parent"]
      },
      // producto-terminado-form-dialog.tsx: el submit necesita preventDefault
      // para reescribir el FormData con los refs de periodo/establecimiento/
      // tipoOperacion antes de invocar la server action. Migrar a `<form
      // action>` (patrón de inventoryForms) haría que React resetease los
      // campos no controlados al terminar la acción, borrando lo capturado
      // cuando la validación del servidor rechaza el registro. La persistencia
      // del formulario ante error es el comportamiento exigido.
      {
        "files": [
          "src/app/dashboard/producto-terminado/registrar/producto-terminado-form-dialog.tsx"
        ],
        "rules": ["react-doctor/no-prevent-default"]
      }
    ]
  },

  // Se mantienen visibles en CLI como deuda, pero se neutralizan del score:
  //  - Reglas de estilo (maintainability) en módulos grandes de producción:
  //    extraer JSX duplicado y dividir componentes giants es refactor de alto
  //    riesgo a granel y no afecta la corrección ni el rendimiento.
  //  - prefer-dynamic-import: los gráficos se renderizan siempre en el
  //    dashboard; import dinámico no aporta deferimiento real sin
  //    code-splitting por ruta.
  //  - async-defer-await: marca todo `await` seguido de guardia. La guardia
  //    POST-await es obligatoria para cancelar el trabajo asíncrono de un
  //    useEffect desmontado (token `activo`); "mover el await debajo de la
  //    guardia" eliminaría esa re-verificación y es semánticamente incorrecto
  //    aquí. Heurística `test-noise` en conflicto con cancelación real.
  "surfaces": {
    "score": {
      "excludeRules": [
        "react-doctor/duplicate-jsx-subtree",
        "react-doctor/no-giant-component",
        "react-doctor/no-high-complexity-react-function",
        "react-doctor/only-export-components",
        "react-doctor/prefer-dynamic-import",
        "react-doctor/async-defer-await"
      ]
    }
  }
}