generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     UserRole[]
  auditLogs AuditLog[]

  movimientosBase   MovimientoBaseActiva[]        @relation("UsuarioBase")
  movimientosPT     MovimientoProductoTerminado[] @relation("UsuarioPT")
  enviosComprobante EnvioComprobante[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Permission {
  id        String           @id @default(cuid())
  codigo    String           @unique
  nombre    String
  modulo    String
  activo    Boolean          @default(true)
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  usuarioId String?
  accion    String
  entidad   String
  entidadId String?
  ruta      String?
  metodo    String?
  detalle   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  usuario   User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, createdAt])
  @@index([entidad, entidadId, createdAt])
  @@index([createdAt])
}

enum TipoInventario {
  BASE_ACTIVA
  PRODUCTO_TERMINADO
}

enum MetodoValuacion {
  PEPS
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum TipoMotivoPT {
  PRODUCCION
  VENTA
  ENSAYO
}

model Empresa {
  id                 String            @id @default(cuid())
  ruc                String            @unique
  razonSocial        String
  activo             Boolean           @default(true)
  logoUrl            String?
  firmaUrl           String?
  responsableReporte String?
  cargoReporte       String?
  periodos           Periodo[]
  establecimientos   Establecimiento[]
  clientes           Cliente[]
  ventas             Venta[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Periodo {
  id              String                        @id @default(cuid())
  empresaId       String
  anio            Int
  activo          Boolean                       @default(true)
  empresa         Empresa                       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientosBase MovimientoBaseActiva[]
  movimientosPT   MovimientoProductoTerminado[]

  @@unique([empresaId, anio])
}

model Establecimiento {
  id              String                        @id @default(cuid())
  empresaId       String
  codigo          String?
  nombre          String
  direccion       String?
  activo          Boolean                       @default(true)
  empresa         Empresa                       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  almacenamientos Almacenamiento[]
  movimientosBase MovimientoBaseActiva[]
  movimientosPT   MovimientoProductoTerminado[]

  @@unique([empresaId, nombre])
}

model UnidadMedida {
  id             String         @id @default(cuid())
  codigo         String?        @unique
  nombre         String         @unique
  activo         Boolean        @default(true)
  productos      Producto[]
  presentaciones Presentacion[]
}

model PresentacionCatalogo {
  id        String   @id @default(cuid())
  codigo    String?  @unique
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TipoExistencia {
  id        String     @id @default(cuid())
  codigo    String     @unique
  nombre    String
  activo    Boolean    @default(true)
  productos Producto[]
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]
}

model Marca {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]
}

model TipoAfectacion {
  id        String     @id @default(cuid())
  codigo    String     @unique
  nombre    String
  activo    Boolean    @default(true)
  productos Producto[]
}

model TipoOperacion {
  id              String                        @id @default(cuid())
  codigo          String                        @unique
  nombre          String                        @unique
  activo          Boolean                       @default(true)
  movimientosBase MovimientoBaseActiva[]        @relation("OperacionBase")
  movimientosPT   MovimientoProductoTerminado[] @relation("OperacionPT")
}

model Almacenamiento {
  id                String                 @id @default(cuid())
  codigo            String                 @unique
  nombre            String
  establecimientoId String
  activo            Boolean                @default(true)
  establecimiento   Establecimiento        @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)
  lotesBase         LoteBaseActiva[]
  movimientosBase   MovimientoBaseActiva[]
}

model Producto {
  id               String          @id @default(cuid())
  tipoInventario   TipoInventario
  codigo           String          @unique
  codigoExistencia String?
  tipoExistenciaId String?
  descripcion      String
  observaciones    String?
  unidadMedidaId   String
  metodoValuacion  MetodoValuacion @default(PEPS)
  categoriaId      String?
  marcaId          String?
  tipoAfectacionId String?
  activo           Boolean         @default(true)

  tipoExistencia TipoExistencia? @relation(fields: [tipoExistenciaId], references: [id])
  unidadMedida   UnidadMedida    @relation(fields: [unidadMedidaId], references: [id])
  categoria      Categoria?      @relation(fields: [categoriaId], references: [id])
  marca          Marca?          @relation(fields: [marcaId], references: [id])
  tipoAfectacion TipoAfectacion? @relation(fields: [tipoAfectacionId], references: [id])
  precioVenta    Decimal         @default(0) @db.Decimal(12, 2)

  presentacion    Presentacion?
  lotesBase       LoteBaseActiva[]
  movimientosBase MovimientoBaseActiva[]
  movimientosPT   MovimientoProductoTerminado[]
  capasPEPSBase   CapaPEPSBase[]
  capasPEPSPT     CapaPEPSPT[]
  ventasDetalle   VentaDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipoInventario])
  @@index([activo, tipoInventario])
  @@index([codigoExistencia])
  @@index([descripcion])
}

model Presentacion {
  id             String                        @id @default(cuid())
  productoId     String                        @unique
  nombre         String
  unidadMedidaId String?
  activo         Boolean                       @default(true)
  producto       Producto                      @relation(fields: [productoId], references: [id], onDelete: Cascade)
  unidadMedida   UnidadMedida?                 @relation(fields: [unidadMedidaId], references: [id])
  movimientosPT  MovimientoProductoTerminado[]
  capasPEPSPT    CapaPEPSPT[]
}

model LoteBaseActiva {
  id               String                 @id @default(cuid())
  productoId       String
  codigo           String                 @unique
  fechaIngreso     DateTime?
  pesoUnitarioKg   Decimal                @default(0) @db.Decimal(18, 6)
  observaciones    String?
  almacenamientoId String?
  producto         Producto               @relation(fields: [productoId], references: [id], onDelete: Restrict)
  almacenamiento   Almacenamiento?        @relation(fields: [almacenamientoId], references: [id])
  movimientos      MovimientoBaseActiva[]
  capasPEPS        CapaPEPSBase[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([productoId])
}

model MovimientoBaseActiva {
  id                        String         @id @default(cuid())
  periodoId                 String
  establecimientoId         String
  productoId                String
  loteId                    String
  almacenamientoId          String?
  usuarioId                 String?
  tipoOperacionId           String?
  fecha                     DateTime
  tipoMovimiento            TipoMovimiento
  observacion               String?
  responsableRegistro       String?
  entradaUnd                Decimal        @default(0) @db.Decimal(18, 6)
  entradaPesoKg             Decimal        @default(0) @db.Decimal(18, 6)
  entradaPesoTotalKg        Decimal        @default(0) @db.Decimal(18, 6)
  salidaUnd                 Decimal        @default(0) @db.Decimal(18, 6)
  salidaPesoUnitarioKg      Decimal        @default(0) @db.Decimal(18, 6)
  salidaPesoTotalKg         Decimal        @default(0) @db.Decimal(18, 6)
  saldoUnd                  Decimal        @default(0) @db.Decimal(18, 6)
  saldoPesoUnitarioKg       Decimal        @default(0) @db.Decimal(18, 6)
  saldoTotalKg              Decimal        @default(0) @db.Decimal(18, 6)
  formulacion               String?
  responsableFormulacion    String?
  cantidadProductoFormulado Decimal?       @db.Decimal(18, 6)
  almacenamientoNombre      String?
  costoUnitarioKg           Decimal?       @db.Decimal(18, 6)
  costoTotalEntrada         Decimal?       @db.Decimal(18, 6)
  costoTotalSalida          Decimal?       @db.Decimal(18, 6)

  periodo         Periodo         @relation(fields: [periodoId], references: [id])
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  producto        Producto        @relation(fields: [productoId], references: [id])
  lote            LoteBaseActiva  @relation(fields: [loteId], references: [id])
  almacenamiento  Almacenamiento? @relation(fields: [almacenamientoId], references: [id])
  usuario         User?           @relation("UsuarioBase", fields: [usuarioId], references: [id])
  tipoOperacion   TipoOperacion?  @relation("OperacionBase", fields: [tipoOperacionId], references: [id])

  capaPEPSEntrada  CapaPEPSBase?        @relation("CapaMovimientoEntradaBase")
  aplicacionesPEPS AplicacionPEPSBase[]

  createdAt DateTime @default(now())

  @@index([periodoId, productoId, fecha])
  @@index([loteId, fecha])
}

model CapaPEPSBase {
  id                  String   @id @default(cuid())
  productoId          String
  loteId              String
  movimientoEntradaId String   @unique
  fechaEntrada        DateTime
  cantidadKgInicial   Decimal  @db.Decimal(18, 6)
  cantidadKgRestante  Decimal  @db.Decimal(18, 6)
  costoUnitarioKg     Decimal? @db.Decimal(18, 6)

  producto          Producto             @relation(fields: [productoId], references: [id], onDelete: Restrict)
  lote              LoteBaseActiva       @relation(fields: [loteId], references: [id], onDelete: Restrict)
  movimientoEntrada MovimientoBaseActiva @relation("CapaMovimientoEntradaBase", fields: [movimientoEntradaId], references: [id], onDelete: Cascade)
  aplicaciones      AplicacionPEPSBase[]

  createdAt DateTime @default(now())

  @@index([productoId, fechaEntrada])
}

model AplicacionPEPSBase {
  id                 String   @id @default(cuid())
  movimientoSalidaId String
  capaId             String
  cantidadKg         Decimal  @db.Decimal(18, 6)
  costoUnitarioKg    Decimal? @db.Decimal(18, 6)
  costoTotal         Decimal? @db.Decimal(18, 6)

  movimientoSalida MovimientoBaseActiva @relation(fields: [movimientoSalidaId], references: [id], onDelete: Cascade)
  capa             CapaPEPSBase         @relation(fields: [capaId], references: [id], onDelete: Restrict)

  @@unique([movimientoSalidaId, capaId])
}

model MovimientoProductoTerminado {
  id                   String         @id @default(cuid())
  periodoId            String
  establecimientoId    String
  productoId           String
  presentacionId       String?
  usuarioId            String?
  tipoOperacionId      String?
  fecha                DateTime
  tipoMovimiento       TipoMovimiento
  documentoTraslado    String?
  serie                String?
  numero               String?
  observacion          String?
  responsableDespacho  String?
  entradaCan           Decimal        @default(0) @db.Decimal(18, 6)
  entradaCostoUnitario Decimal        @default(0) @db.Decimal(18, 6)
  entradaCostoTotal    Decimal        @default(0) @db.Decimal(18, 6)
  salidaCan            Decimal        @default(0) @db.Decimal(18, 6)
  salidaCostoUnitario  Decimal        @default(0) @db.Decimal(18, 6)
  salidaCostoTotal     Decimal        @default(0) @db.Decimal(18, 6)
  motivo               TipoMotivoPT?
  facturaGuia          String?
  empresaDestino       String?
  ingCampo             String?

  periodo         Periodo         @relation(fields: [periodoId], references: [id])
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  producto        Producto        @relation(fields: [productoId], references: [id])
  presentacion    Presentacion?   @relation(fields: [presentacionId], references: [id])
  usuario         User?           @relation("UsuarioPT", fields: [usuarioId], references: [id])
  tipoOperacion   TipoOperacion?  @relation("OperacionPT", fields: [tipoOperacionId], references: [id])

  capaPEPSEntrada  CapaPEPSPT?        @relation("CapaMovimientoEntradaPT")
  aplicacionesPEPS AplicacionPEPSPT[]

  createdAt DateTime @default(now())

  @@index([periodoId, productoId, fecha])
}

model CapaPEPSPT {
  id                  String   @id @default(cuid())
  productoId          String
  presentacionId      String?
  movimientoEntradaId String   @unique
  fechaEntrada        DateTime
  cantidadInicial     Decimal  @db.Decimal(18, 6)
  cantidadRestante    Decimal  @db.Decimal(18, 6)
  costoUnitario       Decimal  @db.Decimal(18, 6)

  producto          Producto                    @relation(fields: [productoId], references: [id], onDelete: Restrict)
  presentacion      Presentacion?               @relation(fields: [presentacionId], references: [id])
  movimientoEntrada MovimientoProductoTerminado @relation("CapaMovimientoEntradaPT", fields: [movimientoEntradaId], references: [id], onDelete: Cascade)
  aplicaciones      AplicacionPEPSPT[]

  createdAt DateTime @default(now())

  @@index([productoId, fechaEntrada])
}

model AplicacionPEPSPT {
  id                 String  @id @default(cuid())
  movimientoSalidaId String
  capaId             String
  cantidad           Decimal @db.Decimal(18, 6)
  costoUnitario      Decimal @db.Decimal(18, 6)
  costoTotal         Decimal @db.Decimal(18, 6)

  movimientoSalida MovimientoProductoTerminado @relation(fields: [movimientoSalidaId], references: [id], onDelete: Cascade)
  capa             CapaPEPSPT                  @relation(fields: [capaId], references: [id], onDelete: Restrict)

  @@unique([movimientoSalidaId, capaId])
}

model Cliente {
  id              String        @id @default(cuid())
  empresaId       String
  tipoDocumento   TipoDocumento
  numeroDocumento String
  razonSocial     String
  direccion       String?
  telefono        String?
  email           String?
  activo          Boolean       @default(true)
  empresa         Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ventas          Venta[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tipoDocumento, numeroDocumento])
  @@index([empresaId])
  @@index([numeroDocumento])
  @@index([razonSocial])
  @@index([activo])
}

enum TipoDocumento {
  DNI
  RUC
  CE
  PASAPORTE
  OTRO
}

model Venta {
  id               String             @id @default(cuid())
  empresaId        String
  tipoComprobante  TipoComprobante
  serie            String
  numero           Int
  fecha            DateTime           @default(now())
  clienteId        String?
  cliente          Cliente?           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  formaPago        FormaPago
  metodoPago       MetodoPago
  subtotal         Decimal            @db.Decimal(12, 2)
  igv              Decimal            @db.Decimal(12, 2)
  total            Decimal            @db.Decimal(12, 2)
  estado           EstadoVenta        @default(EMITIDA)
  observacion      String?
  moneda           String             @default("PEN")
  tipoCambio       Decimal            @default(1) @db.Decimal(12, 4)
  opGravada        Decimal            @default(0) @db.Decimal(12, 2)
  opExonerada      Decimal            @default(0) @db.Decimal(12, 2)
  opInafecta       Decimal            @default(0) @db.Decimal(12, 2)
  numeroOperacion  String?
  fechaVencimiento DateTime?
  recibido         Decimal?           @db.Decimal(12, 2)
  vuelto           Decimal?           @db.Decimal(12, 2)
  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  detalles         VentaDetalle[]
  envios           EnvioComprobante[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([tipoComprobante, serie, numero])
  @@index([empresaId, fecha])
  @@index([empresaId, tipoComprobante, serie])
  @@index([clienteId])
  @@index([tipoComprobante])
  @@index([estado])
}

enum TipoComprobante {
  COTIZACION
  FACTURA
  BOLETA
  NOTA_DE_VENTA
}

enum FormaPago {
  CONTADO
  CREDITO
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
  TARJETA
  DEPOSITO
  OTRO
}

enum EstadoVenta {
  EMITIDA
  ANULADA
}

model VentaDetalle {
  id             String   @id @default(cuid())
  ventaId        String
  productoId     String
  cantidad       Decimal  @db.Decimal(12, 3)
  precioUnitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  igv            Decimal  @default(0) @db.Decimal(12, 2)
  importe        Decimal  @default(0) @db.Decimal(12, 2)
  unidadMedida   String?
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ventaId])
  @@index([productoId])
}

enum TipoEnvio {
  CORREO
  WHATSAPP
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADO
  ERROR
}

model EnvioComprobante {
  id            String      @id @default(cuid())
  ventaId       String
  tipo          TipoEnvio
  estado        EstadoEnvio @default(PENDIENTE)
  destino       String
  mensaje       String
  error         String?
  usuarioId     String?
  enviadoAt     DateTime?
  createdAt     DateTime    @default(now())
  actualizadoAt DateTime    @updatedAt
  venta         Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  usuario       User?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ventaId])
  @@index([tipo])
  @@index([estado])
}
